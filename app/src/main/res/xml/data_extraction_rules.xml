<?xml version="1.0" encoding="utf-8"?>
<!-- Only the ball set and recent calculations (DataStore) are backed up and transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
